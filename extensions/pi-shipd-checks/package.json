{
  "name": "@sreetej510/pi-shipd-checks",
  "version": "0.9.8",
  "description": "Pi extension that runs a strict, multi-agent fairness review of a benchmark task's agent_prompt.md, test.patch, and solution.patch, plus behavioral test-gap analysis, via /checks.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "review",
    "checks",
    "shipd"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs && node scripts/build-fargate-worker.mjs",
    "prepublishOnly": "npm run build",
    "check": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "smoke:playwright-auth": "node scripts/playwright-auth-smoke.mjs",
    "smoke:playwright-quality": "node scripts/playwright-quality-concurrent-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "typebox": "^1.3.3",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sreetej510/pi-extensions",
    "directory": "extensions/pi-shipd-checks"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1104.0",
    "@aws-sdk/client-ecs": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/client-sts": "^3.1104.0",
    "@aws-sdk/credential-provider-node": "^3.972.78",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "pi-commandcode-provider": "0.6.0",
    "playwright-core": "^1.62.1"
  }
}
